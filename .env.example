# ==============================================================================
# DAC System Environment Configuration Template (.env.example)
# NEVER commit .env containing actual secrets to version control.
# ==============================================================================

# Server & Database Configuration
PORT=5001
PGHOST=localhost
PGPORT=5432
PGUSER=ayu
PGPASSWORD=
PGDATABASE=dacexpertsys

# Supabase (Session pooler). When set, it replaces the PG* settings above.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:5001/api

# Google OAuth Credentials (for Login)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Gemini LLM & Embeddings (Backend ONLY - Never expose to frontend)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# RAG & Vector Retrieval Settings
RAG_TOP_K=5
RAG_MIN_SCORE=0.50
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=200
